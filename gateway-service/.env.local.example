# Gateway Service - Local Development Environment
# Copy to .env for running service locally (not in Docker)
# Use this when infrastructure runs in Docker but service runs on host

SERVICE_NAME=gateway-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# API server
API_HOST=0.0.0.0
API_PORT=8080

# Security
API_KEY=your_secure_api_key_here

# Connect to Docker infrastructure on localhost
REDIS_URL=redis://localhost:6379/0

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=layerbit

# API configuration
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=500

CORS_ORIGINS=["*"]

# Caching
CACHE_TTL_SECONDS=300
