SERVICE_NAME=edge-agents-service
ENVIRONMENT=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8082

REDIS_URL=redis://0.0.0.0:6379/0

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=layerbit

LLM_CLIENT=instructor
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=3
OPENROUTER_REFERER=https://layerbit-oraculum.ai
OPENROUTER_APP_TITLE=Layerbit Oraculum AI
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/layerbit
MODELS_CONFIG_PATH=app/config/models.yaml
ACTIVE_MODEL_NAME=gpt-4o-mini

LLM_TIMEOUT=30

DEFAULT_LEAGUES=["soccer_uefa_champs_league"]
MIN_CONFIDENCE_THRESHOLD=0.0
