# Odds Service - Local Development Environment
# Copy to .env for running service locally (not in Docker)
# Use this when infrastructure runs in Docker but service runs on host

SERVICE_NAME=odds-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Connect to Docker infrastructure on localhost
REDIS_URL=redis://localhost:6379/0

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=layerbit

# External API configuration
ODDS_API_KEY=your_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_REGIONS=["eu"]
ODDS_API_MARKETS=["h2h"]
ODDS_API_LEAGUES=["soccer_uefa_champs_league"]

# Scheduling
SCHEDULE_CRONS=["0 9 * * *","0 19 * * *"]

# Admin API server
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8081
