Project layerbit_oraculs_bet {
  database_type: 'PostgreSQL'
  Note: '''
    # Layerbit Oraculs Bet Database Schema
    
    This schema represents the database structure for the Layerbit Oraculs Bet system,
    including both the odds-service and gateway-service components.
    
    ## Key Features:
    - User authentication and identity management
    - Sports betting odds collection and normalization
    - Event and team management
    - Bookmaker integration
  '''
}

// =============================================================================
// USER MANAGEMENT TABLES (Gateway Service)
// =============================================================================

Table users {
  id uuid [pk, default: `uuid_generate_v4()`]
  email text [unique, note: 'nullable, indexed']
  email_verified bool [not null, default: false]
  password_hash text [note: 'nullable for OAuth users']
  plan_type text [not null, default: 'free', note: 'enum: free, pro, partner']
  trial_end_at timestamptz [note: 'nullable']
  telegram_account_id bigint [unique, note: 'nullable, indexed']
  telegram_is_premium bool [note: 'nullable']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  Note: 'User accounts with multiple authentication providers'
}

Table user_identities {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [ref: > users.id, not null, note: 'CASCADE delete']
  provider text [not null, note: 'enum: google, password, telegram']
  provider_user_id text [not null]
  username text [note: 'nullable']
  first_name text [note: 'nullable']
  last_name text [note: 'nullable']
  language_code text [note: 'nullable']
  photo_url text [note: 'nullable']
  is_premium bool [note: 'nullable']
  created_at timestamptz [not null, default: `now()`]
  
  Note: 'User identity providers - UNIQUE constraint on (provider, provider_user_id)'
}

Table user_sessions {
  jti uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [ref: > users.id, not null, note: 'CASCADE delete']
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  user_agent text [note: 'nullable']
  
  Note: 'JWT session tokens'
}

// =============================================================================
// SPORTS & BETTING TABLES (Odds Service)
// =============================================================================

Table sports {
  id uuid [pk, default: `uuid_generate_v4()`]
  name text [unique, not null]
  display_name text [not null]
  is_active bool [default: true]
  created_at timestamptz [default: `now()`]
  
  Note: 'Sports categories (football, basketball, etc.)'
}

Table competitions {
  id uuid [pk, default: `uuid_generate_v4()`]
  sport_id uuid [ref: > sports.id, not null, note: 'CASCADE delete']
  key text [unique, not null]
  name text [not null]
  region text [not null]
  is_active bool [default: true]
  created_at timestamptz [default: `now()`]
  
  Note: 'Sports competitions with regional information'
}

Table teams {
  id uuid [pk, default: `uuid_generate_v4()`]
  name text [not null]
  normalized_name text [unique, not null]
  sport_id uuid [ref: > sports.id, not null, note: 'CASCADE delete']
  external_ids jsonb [default: `{}`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  
  Note: 'Sports teams with external ID mappings'
}

Table events {
  id uuid [pk, default: `uuid_generate_v4()`]
  external_id text [unique, not null]
  sport_id uuid [ref: > sports.id, not null, note: 'CASCADE delete']
  competition_id uuid [ref: > competitions.id, not null, note: 'CASCADE delete']
  home_team_id uuid [ref: > teams.id, not null, note: 'CASCADE delete']
  away_team_id uuid [ref: > teams.id, not null, note: 'CASCADE delete']
  commence_time timestamptz [not null]
  status text [default: 'upcoming', note: 'enum: upcoming, live, completed, cancelled']
  event_metadata jsonb [default: `{}`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  
  Note: 'Sports events with team matchups'
}

Table bookmakers {
  id uuid [pk, default: `uuid_generate_v4()`]
  key text [unique, not null]
  name text [not null]
  region text [not null]
  is_active bool [default: true]
  created_at timestamptz [default: `now()`]
  
  Note: 'Betting bookmakers and their regions'
}

Table odds_snapshots {
  id uuid [pk, default: `uuid_generate_v4()`]
  event_id uuid [ref: > events.id, not null, note: 'CASCADE delete']
  bookmaker_id uuid [ref: > bookmakers.id, not null, note: 'CASCADE delete']
  market_type text [not null, note: 'enum: h2h, spreads, totals']
  outcomes jsonb [not null]
  timestamp_source timestamptz [not null]
  timestamp_ingested timestamptz [default: `now()`]
  created_at timestamptz [default: `now()`]
  
  Note: 'Raw odds data from bookmakers'
}

Table normalized_odds {
  id uuid [pk, default: `uuid_generate_v4()`]
  event_id uuid [ref: > events.id, not null, note: 'CASCADE delete']
  market_type text [not null]
  home_odds_avg decimal(10,2) [not null]
  away_odds_avg decimal(10,2) [not null]
  draw_odds_avg decimal(10,2) [note: 'nullable for non-draw sports']
  home_odds_best decimal(10,2) [not null]
  away_odds_best decimal(10,2) [not null]
  draw_odds_best decimal(10,2) [note: 'nullable for non-draw sports']
  bookmakers_count int [not null, default: 0]
  timestamp_source timestamptz [not null]
  timestamp_ingested timestamptz [not null]
  timestamp_normalized timestamptz [default: `now()`]
  created_at timestamptz [default: `now()`]
  
  Note: 'Normalized odds with aggregated statistics'
}

// =============================================================================
// MISSING TABLES (Not found in current codebase)
// =============================================================================

Table prediction_history {
  id uuid [pk, default: `uuid_generate_v4()`]
  event_id uuid [ref: > events.id, not null, note: 'CASCADE delete']
  predicted text [not null, note: 'enum: home, draw, away']
  actual text [not null, note: 'enum: home, draw, away']
  edge_at_prediction decimal(10,2) [not null]
  accuracy_flag bool [not null]
  created_at timestamptz [default: `now()`]
  
  Note: 'MISSING TABLE - Referenced in focus_entities but not found in codebase'
}

